PORT=5051

# MongoDB Atlas (database "chat")
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat?retryWrites=true&w=majority

# Must be identical in the API service
JWT_SECRET=change-me
INTERNAL_SECRET=change-me-too

# Comma-separated, or * during development. Capacitor: capacitor://localhost (iOS), https://localhost (Android)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

# Push notifications (Firebase console -> Project settings -> Service accounts ->
# Generate new private key). Paste the whole JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
